---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssueMasthead from '../../components/IssueMasthead.astro';
import EntryStory from '../../components/EntryStory.astro';
import { getCatalog, getIssues, formatDate } from '../../lib/data';
import type { Issue } from '../../lib/data';

export function getStaticPaths() {
  return getIssues().map((issue) => ({ params: { date: issue.date }, props: { issue } }));
}

const { issue } = Astro.props as { issue: Issue };
const catalog = await getCatalog();
const topicIds = new Set(catalog.series.map((series) => series.id));
const title = `${formatDate(issue.date)}｜机会画报`;
const description = issue.entries[0]?.plain ?? '当天没有内容达到精品发布线。';
---

<BaseLayout title={title} description={description} canonicalPath={`/issues/${issue.date}/`} pageClass="issue-page">
  <IssueMasthead issue={issue} compact />
  <section class="issue-stories issue-detail" aria-label={`${issue.date} 全部精品`}>
    {issue.entries.length ? issue.entries.map((entry, index) => (
      <EntryStory entry={entry} index={index + 1} featured={entry.quality === 'feature'} showTopic={topicIds.has(entry.seriesId)} />
    )) : (
      <div class="no-quality-day">
        <p class="section-kicker">NO FILLER</p>
        <h2>没有精品，也是一条结果。</h2>
        <p>当天抓到 {issue.counts.collected} 条公开信号，旧规则曾保留 {issue.counts.oldAccepted} 条；重新复核后没有条目达到发布线。</p>
      </div>
    )}
  </section>
  {issue.failedSources.length > 0 && (
    <details class="source-status">
      <summary>查看当天失败或需要补充的来源</summary>
      <ul>{issue.failedSources.map((item) => <li><strong>{item.source}</strong> · {item.status}<br />{item.detail}</li>)}</ul>
    </details>
  )}
</BaseLayout>
